      "properties": {
        "id": { "type": "string" },
        "noSeri": { "type": "string" },
        "tanggalAngkutan": { "type": "string" },
        "namaPemohon": { "type": "string" },
        "pekerjaanPemohon": { "type": "string" },
        "alamatPemohon": { "type": "string" },
        "jenisKendaraan": { "type": "string" },
        "namaSupir": { "type": "string" },
        "nopol": { "type": "string" },
        "jenisKayu": { "type": "string" },
        "items": { "type": "array" },
        "totalBtg": { "type": "number" },
        "totalM3": { "type": "number" },
        "namaPenerima": { "type": "string" },
        "alamatPenerima": { "type": "string" },
        "namaTujuan": { "type": "string" },
        "alamatTujuan": { "type": "string" },
        "noDkhp": { "type": "string" },
        "pejabatNama": { "type": "string" },
        "pejabatReg": { "type": "string" },
        "status": { "type": "string" },
