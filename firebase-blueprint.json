      "description": "Data kapling persediaan kayu pihak ketiga TPK Talok",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "noKapling": { "type": "string" },
        "noBlok": { "type": "string" },
        "jenisKayu": { "type": "string" },
        "sortimen": { "type": "string" },
        "panjang": { "type": "string" },
        "mutu": { "type": "string" },
        "batang": { "type": "number" },
        "volume": { "type": "number" },
        "noInvoice": { "type": "string" },
        "pembeli": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "noKapling", "jenisKayu"]
    }
  },
  "firestore": {
    "/permohonan/{permohonanId}": {
      "schema": "Permohonan",
      "description": "Koleksi dokumen permohonan angkutan kayu TPK Talok"
    },
    "/persediaan/{kaplingId}": {
